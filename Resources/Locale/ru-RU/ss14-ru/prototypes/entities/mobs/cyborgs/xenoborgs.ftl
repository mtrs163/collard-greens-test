ent-XenoborgEngi = инженерный ксеноборг
    .desc = Гибрид человека и машины, стремящийся к репликации. Они любят извлекать мозги и вставлять их в свежие шасси ксеноборгов, чтобы увеличивать свою армию. Судя по всему, этот - инженерный. У него больше инструментов для поддержки других ксеноборгов.
    .suffix = с мозгом
ent-XenoborgEngiPrinted = { ent-XenoborgEngi }
    .desc = { ent-XenoborgEngi.desc }
    .suffix = без мозга
